# --- Base de datos (Supabase) ---
# Cadena de conexion de Postgres. En Supabase: Project Settings -> Database.
#
# Recomendado: "Session Pooler" (evita el problema de IPv6 en Windows).
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# El "Transaction Pooler" (puerto 6543) tambien sirve: el cliente ya usa
# `prepare: false`. NO uses la conexion directa (db.<ref>.supabase.co) si tu
# red no tiene IPv6.
DATABASE_URL=

# --- Sesion ---
# En desarrollo se puede dejar vacio (genera uno efimero).
# En produccion es obligatorio: generar con `openssl rand -hex 32`
SESSION_SECRET=

# --- Modo demo ---
# Muestra el aviso "datos simulados" en la interfaz
DEMO_MODE=true

# --- Precios ---
# auto = usa ITAD si hay key, si no cae a datos ficticios
# itad = fuerza ITAD
# mock = fuerza datos ficticios
PRICES_SOURCE=auto

# Region y moneda por defecto de los precios
DEFAULT_COUNTRY=CL
DEFAULT_CURRENCY=CLP

# --- IsThereAnyDeal (opcional) ---
# Registra la app en https://isthereanydeal.com/apps/my para obtenerla.
# Con la key puesta, el comparador muestra precios reales de las 3 tiendas.
ITAD_API_KEY=
ITAD_API_BASE=https://api.isthereanydeal.com

# --- Tiendas (futuro, ver ANALISIS-APIs.md) ---
# Se dejan vacias mientras la biblioteca sea simulada.
STEAM_API_KEY=
GOG_CLIENT_ID=
